# Configuración del Polymarket CopyBot para ejecutarlo en un servidor o en tu ordenador.
# Copia este archivo a .env y rellénalo:   cp .env.example .env
# .env está en .gitignore y .dockerignore: nunca se sube a GitHub ni entra en la imagen de Docker.

# --- Modo de operación ---------------------------------------------------------
# true = simulación (no envía órdenes). Ponlo a false solo cuando hayas probado en simulación.
DRY_RUN=true

# --- Riesgo ----------------------------------------------------------------------
MAX_SLIPPAGE_PCT=0.025          # peor precio aceptable respecto al del líder (2,5 %)
MAX_POSITION_WEIGHT_PCT=0.25    # máximo de la sub-banca en una sola operación (25 %)
MIN_ORDER_USDC=2.0              # órdenes más pequeñas no se envían
MAX_TRADE_AGE_MINUTES=60        # compras del líder más antiguas que esto no se copian

# --- Ritmo -----------------------------------------------------------------------
POLL_INTERVAL_SECONDS=4         # cada cuántos segundos se revisan los traders en modo continuo
HEARTBEAT_HOURS=24              # aviso por Telegram de que el bot sigue vivo (0 = nunca)
RESOLUTION_CHECK_INTERVAL_SECONDS=300
MAX_ACTIVITY_PAGES=10

# --- Telegram (opcional, recomendado) --------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Polygon ---------------------------------------------------------------------
# RPC propio (Alchemy, Infura, QuickNode…). Vacío = se usan RPCs públicos de respaldo.
POLYGON_RPC_URL=

# --- Polymarket (solo para DRY_RUN=false) ----------------------------------------
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=2     # 2 = cartera de polymarket.com, 1 = Poly proxy (email), 0 = EOA
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# Proxy para las órdenes. Solo hace falta si el servidor está en EE. UU. u otro país
# donde Polymarket no permite operar; en un servidor fuera de ellos, déjalo vacío.
HTTP_PROXY_URL=
